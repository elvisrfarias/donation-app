# =========================================================================
#  Copie para `.env` e ajuste. NUNCA versione o `.env` real.
#  Lido pelo docker-compose e injetado nos containers como env vars.
# =========================================================================

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=doacao
POSTGRES_PASSWORD=troque-esta-senha-em-producao
POSTGRES_DB=doacao
POSTGRES_PORT=5432

# ---- API -----------------------------------------------------------------
# Connection string montada a partir das credenciais acima.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=doacao;Username=doacao;Password=troque-esta-senha-em-producao
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8088

# Aplicar migrations automaticamente no startup (apenas dev).
RunMigrationsOnStartup=true
# Criar usuário admin de seed no startup.
SeedData__Enabled=true
SeedData__AdminEmail=admin@doacao.local
SeedData__AdminPassword=Admin@123456

# ---- JWT -----------------------------------------------------------------
# Em produção, use um segredo forte (>= 32 bytes) vindo de um cofre/secret manager.
Jwt__Issuer=doacao-app
Jwt__Audience=doacao-app-clients
Jwt__Secret=CHAVE-SUPER-SECRETA-COM-NO-MINIMO-32-CARACTERES-troque
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- BCrypt --------------------------------------------------------------
# Work factor (custo). 12 é um bom equilíbrio em 2026; aumente conforme o hardware.
Security__BCryptWorkFactor=12

# ---- MinIO / Object Storage (imagens) ------------------------------------
# Credenciais do MinIO (em produção: troque e use as do seu provedor S3).
MINIO_ROOT_USER=doacao
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_API_PORT=9000       # API S3 (e host das URLs pré-assinadas)
MINIO_CONSOLE_PORT=9001   # Console web do MinIO (http://localhost:9001)

# Configuração do storage lida pela API.
# Para migrar p/ Amazon S3: Storage__Provider=AmazonS3, limpe ServiceUrl/PublicUrl,
# defina Storage__Region e use MINIO_ROOT_USER/PASSWORD com a access/secret key da AWS.
Storage__Provider=MinIO
Storage__ServiceUrl=http://minio:9000      # endpoint interno (servidor -> storage)
Storage__PublicUrl=http://localhost:9000   # endpoint público (navegador -> URLs pré-assinadas)
Storage__Region=us-east-1
Storage__Bucket=doacao
Storage__ForcePathStyle=true
Storage__PresignExpiryMinutes=60

# ---- PGAdmin (dev) -------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@doacao.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---- Frontend ------------------------------------------------------------
# Porta em que o frontend (nginx) é exposto no host.
FRONTEND_PORT=5445