# Diretivas globais (contexto http) do nginx de borda. Vira conf.d/00-http.conf no boot.

server_tokens off;

# Timeouts curtos contra slowloris; corpo pequeno por padrão (só /api/ aceita uploads).
client_header_timeout 15s;
client_body_timeout   15s;
send_timeout          30s;
client_max_body_size  1m;

# IP real do visitante (o Cloudflare fica na frente) — base dos limites abaixo.
include /etc/nginx/snippets/cloudflare-realip.conf;

# Limites por IP: API em geral, rotas de autenticação e conexões simultâneas.
# A API tem limites próprios mais finos; estes seguram abuso antes de chegar nela.
limit_req_zone  $binary_remote_addr zone=edge_api:10m  rate=10r/s;
limit_req_zone  $binary_remote_addr zone=edge_auth:10m rate=30r/m;
limit_req_zone  $binary_remote_addr zone=edge_files:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=edge_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# Resolve os containers em runtime (DNS do Docker), para sobreviver a reinícios.
resolver 127.0.0.11 valid=10s ipv6=off;
