# ==========================================================================
#  .gitignore raiz do monorepo — regras transversais (valem para tudo).
#  Regras específicas de .NET ficam em backend/.gitignore; o futuro
#  frontend/ deve ter o seu próprio (node_modules/, dist/, etc.).
# ==========================================================================

# Editores / IDEs
.idea/
.vs/
.vscode/
*.DotSettings.user

# Sistema operacional
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Segredos / ambiente local (o .env.example versionado é a referência)
.env
*.env
!.env.example

# Backups locais (make backup) — contêm dados reais, nunca versionar
/backups/

# Configuração local do Claude Code (guardrails pessoais: ask p/ remoção e escrita no banco)
.claude/settings.local.json
.claude/hooks/guard-db-and-rm.sh

.env.prod
