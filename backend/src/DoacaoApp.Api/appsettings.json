{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=doacao;Username=doacao;Password=doacao"
  },
  "RunMigrationsOnStartup": true,
  "Jwt": {
    "Issuer": "doacao-app",
    "Audience": "doacao-app-clients",
    "Secret": "CHAVE-DE-DESENVOLVIMENTO-COM-NO-MINIMO-32-CARACTERES",
    "AccessTokenHours": 4,
    "RefreshTokenHours": 8
  },
  "Security": {
    "BCryptWorkFactor": 12
  },
  "ForwardedHeaders": {
    "KnownNetworkCidr": "172.28.0.0/16"
  },
  "SeedData": {
    "Enabled": true,
    "DemoData": false,
    "AdminEmail": "admin@doacao.local",
    "AdminPassword": "Admin@123456"
  },
  "Storage": {
    "Provider": "MinIO",
    "ServiceUrl": "http://localhost:9000",
    "PublicUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "doacao",
    "SecretKey": "troque-esta-senha-minio",
    "Bucket": "doacao",
    "ForcePathStyle": true,
    "PresignExpiryMinutes": 60
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/*",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "5m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/auth/refresh",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/doacao-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [Corr:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}