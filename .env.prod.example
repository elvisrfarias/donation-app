# Copie para .env.prod no servidor (NUNCA versione). Gere segredos com: openssl rand -base64 48
APP_DOMAIN=doacao.exemplo.com.br
STORAGE_DOMAIN=arquivos.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

POSTGRES_USER=doacao
POSTGRES_PASSWORD=GERAR
POSTGRES_DB=doacao
ConnectionStrings__Database=Host=postgres;Port=5432;Database=doacao;Username=doacao;Password=GERAR

Jwt__Issuer=doacao-app
Jwt__Audience=doacao-app-clients
Jwt__Secret=GERAR
Jwt__AccessTokenHours=4
Jwt__RefreshTokenHours=8
Security__BCryptWorkFactor=12

MINIO_ROOT_USER=GERAR
MINIO_ROOT_PASSWORD=GERAR
# Credencial só da API, restrita ao bucket (criada pelo minio-init). A root fica só para administração.
MINIO_APP_ACCESS_KEY=doacao-api
MINIO_APP_SECRET_KEY=GERAR
Storage__Provider=MinIO
Storage__ServiceUrl=http://minio:9000
Storage__Region=us-east-1
Storage__Bucket=doacao
Storage__ForcePathStyle=true
Storage__PresignExpiryMinutes=60

SeedData__Enabled=false
SeedData__AdminEmail=admin@exemplo.com.br
SeedData__AdminPassword=GERAR

BRAND_PRIMARY=
