# URL base da API consumida pelo cliente HTTP do navegador.
# Em desenvolvimento, mantenha "/api" para passar pelo proxy do Vite (evita CORS).
# Em produção (build estático), aponte para o host real da API, ex.: https://api.seudominio.com
VITE_API_URL=/api

# Alvo do proxy de desenvolvimento do Vite: encaminha /api -> API .NET.
VITE_API_PROXY_TARGET=http://localhost:8080

# Geocodificador do OpenStreetMap (Nominatim) usado para converter endereços em coordenadas.
# Respeite a política de uso: https://operations.osmfoundation.org/policies/nominatim/
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# BrasilAPI: autopreenche o endereço pelo CEP e serve de fallback de coordenadas.
VITE_BRASILAPI_URL=https://brasilapi.com.br

# Centro e zoom iniciais do mapa (padrão: Concórdia, SC).
VITE_MAP_DEFAULT_LAT=-27.2342
VITE_MAP_DEFAULT_LNG=-52.0278
VITE_MAP_DEFAULT_ZOOM=13
